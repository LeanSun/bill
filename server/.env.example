# 轻账后端 · 环境变量样板
# 复制成 .env 仅供自己参考；服务本身不读 .env，用 shell / systemd / Docker 注入。

# 监听
PORT=8787
HOST=0.0.0.0

# 访问口令。不设则在首次启动时随机生成，写入 server/data/password.txt 并打印一次
LEDGER_PASSWORD=换成你自己的长口令

# 令牌签名密钥（不设则自动生成存 server/data/secret.key）
# 换掉它 = 所有已签发令牌立即失效，等于强制所有设备重新登录
# TOKEN_SECRET=

# 令牌有效期（天）
TOKEN_TTL_DAYS=30

# 允许跨域的来源。GitHub Pages 上的站点必须写在这里，否则浏览器会拦掉请求
# 多个用逗号分隔；留 * 表示允许任何来源（自己的服务器上不建议）
ALLOWED_ORIGINS=https://leansun.github.io,http://127.0.0.1:8787

# 数据目录 / 请求体上限 / 备份保留份数
# LEDGER_DATA=/var/lib/qingzhang
MAX_BODY_MB=8
BACKUP_KEEP=20

# 设 1 关闭逐条请求日志
# QUIET=1
